<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        Android Studio's on-the-fly lint flags every @Serializable class (DTOs, navigation routes) because it
        inspects the code generated by the kotlinx.serialization compiler plugin, which legitimately uses
        @InternalSerializationApi declarations. Our own code can't misuse that API unnoticed: the Kotlin
        compiler itself enforces this opt-in at error level, so accepting it here only silences the false positive.
    -->
    <issue id="UnsafeOptInUsageError">
        <option name="opt-in" value="kotlinx.serialization.InternalSerializationApi" />
    </issue>
</lint>
